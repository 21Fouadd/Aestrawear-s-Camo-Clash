{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "camo-clash-aestrawear",
  "account_id": "1d0e46e9493343df776579aa295f9d24",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "camo-clash-production",
      "database_id": "7922f42c-7f84-458e-96b3-d6b2104ed8b6",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
