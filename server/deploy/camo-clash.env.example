# Install as /etc/camo-clash/camo-clash.env with owner root:root and mode 0600.
# Do not put this populated file in Git or inside a release archive.
NODE_ENV=production
HOST=127.0.0.1
PORT=3002
PUBLIC_BASE_URL=https://game-api.example.com
ALLOWED_ORIGINS=https://camo-clash-aestrawear.aestrawear-camo-clash.workers.dev
MATCH_TICKET_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
LOG_LEVEL=info
